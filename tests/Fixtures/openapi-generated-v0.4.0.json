    "components": {
        "securitySchemes": {
            "apiToken": {
                "type": "http",
                "scheme": "bearer",
                "description": "A personal API token, carrying the permissions chosen when it was created."
            },
            "oauth2": {
                "type": "oauth2",
                "flows": {
                    "authorizationCode": {
                        "authorizationUrl": "https://things.example.test/oauth/authorize",
                        "tokenUrl": "https://things.example.test/oauth/token",
                        "refreshUrl": "https://things.example.test/oauth/token",
                        "scopes": {
                            "things:read": "Read things",
                            "things:write": "Write things",
                            "mcp:use": "Connect over MCP",
                            "search:use": "search:use"
                        }
                    }
                }
            }
        },
        "schemas": {
            "CreateThing": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            },
            "Thing": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "parent"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "parent": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/Thing"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            },
            "ThingEnvelope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Thing"
                    }
                }
            }
